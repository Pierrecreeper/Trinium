  <profiles>
    <profile><id>review</id><build><plugins><plugin>
      <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
      <executions>
          <execution><id>stage-review-evidence</id><phase>prepare-package</phase><goals><goal>exec</goal></goals><configuration>
            <executable>python3</executable><arguments><argument>${project.basedir}/scripts/review-evidence.py</argument><argument>stage</argument><argument>--root</argument><argument>${project.basedir}</argument><argument>--classes</argument><argument>${project.build.outputDirectory}</argument></arguments>
          </configuration></execution>
      </executions>
    </plugin></plugins></build></profile>

    <profile><id>native</id><activation><activeByDefault>true</activeByDefault></activation><properties><trinium.requireNative>true</trinium.requireNative></properties><build><plugins>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version><executions>
        <execution><id>rust-tests</id><phase>generate-resources</phase><goals><goal>exec</goal></goals><configuration>
          <executable>cargo</executable><arguments><argument>test</argument><argument>--release</argument><argument>--locked</argument><argument>--offline</argument><argument>--manifest-path</argument><argument>${project.basedir}/native/Cargo.toml</argument></arguments>
        </configuration></execution>
        <execution><id>rust-build</id><phase>generate-resources</phase><goals><goal>exec</goal></goals><configuration>
          <executable>cargo</executable><arguments><argument>build</argument><argument>--release</argument><argument>--locked</argument><argument>--offline</argument><argument>--manifest-path</argument><argument>${project.basedir}/native/Cargo.toml</argument></arguments>
        </configuration></execution>
        <execution><id>stage-native</id><phase>process-classes</phase><goals><goal>exec</goal></goals><configuration>
          <executable>${java.home}/bin/java</executable><arguments><argument>--class-path</argument><argument>${project.build.outputDirectory}</argument><argument>${project.basedir}/build-tools/PackageNatives.java</argument><argument>host</argument><argument>${project.basedir}</argument><argument>${project.build.outputDirectory}</argument></arguments>
        </configuration></execution>
      </executions></plugin>
    </plugins></build></profile>
    <profile>
      <id>universal</id>
      <properties><trinium.requireNative>true</trinium.requireNative></properties>
      <build>
        <finalName>Trinium-${project.version}-mc26.3-universal</finalName>
        <plugins><plugin>
          <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
          <executions>
            <execution><id>assemble-universal-natives</id><phase>process-classes</phase><goals><goal>exec</goal></goals>
              <configuration>
                <executable>${java.home}/bin/java</executable>
                <arguments>
                  <argument>--class-path</argument><argument>${project.build.outputDirectory}</argument>
                  <argument>${project.basedir}/build-tools/PackageNatives.java</argument>
                  <argument>universal</argument><argument>${project.basedir}</argument><argument>${project.build.outputDirectory}</argument>
                </arguments>
              </configuration>
            </execution>
            <execution><id>verify-universal-jar</id><phase>verify</phase><goals><goal>exec</goal></goals>
              <configuration>
                <executable>${java.home}/bin/java</executable>
                <arguments><argument>-jar</argument><argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                  <argument>--verify-universal</argument><argument>--require-native</argument><argument>--selftest</argument>
                </arguments>
              </configuration>
            </execution>
          </executions>
        </plugin></plugins>
      </build>
    </profile>
  </profiles>
