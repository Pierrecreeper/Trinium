  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>native</directory><targetPath>trinium-build/native</targetPath><includes><include>Cargo.toml</include><include>Cargo.lock</include><include>src/*.rs</include></includes></resource>
    </resources>
    <finalName>Trinium-${project.version}-mc26.3</finalName>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><configuration><proc>none</proc></configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version><configuration><skipTests>true</skipTests></configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
        <configuration><archive><manifest><mainClass>fr.pierrecreeper.trinium.TriniumCli</mainClass></manifest></archive></configuration>
      </plugin>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
        <executions>

          <execution><id>local-native-build-controller-tests</id><phase>test</phase><goals><goal>java</goal></goals><configuration>
            <mainClass>fr.pierrecreeper.trinium.LocalNativeBuildTest</mainClass><classpathScope>test</classpathScope><systemProperties><systemProperty><key>trinium.projectDir</key><value>${project.basedir}</value></systemProperty></systemProperties>
          </configuration></execution>
          <execution><id>configuration-migration-tests</id><phase>test</phase><goals><goal>java</goal></goals><configuration><mainClass>fr.pierrecreeper.trinium.TriniumConfigurationTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>real-game-contract-tests</id><phase>test</phase><goals><goal>java</goal></goals><configuration><mainClass>fr.pierrecreeper.trinium.GameContractTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>chest-frustum-bounds-tests</id><phase>test</phase><goals><goal>java</goal></goals><configuration><mainClass>fr.pierrecreeper.trinium.graphics.ChestFrustumCullingTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>climate-distance-arithmetic-tests</id><phase>test</phase><goals><goal>java</goal></goals><configuration><mainClass>fr.pierrecreeper.trinium.graphics.ClimateDistanceMathTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>shader-target-contract-tests</id><phase>test</phase><goals><goal>java</goal></goals><configuration><mainClass>fr.pierrecreeper.trinium.shaders.ShaderTargetsTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>standalone-shader-pack-tests</id><phase>test</phase><goals><goal>java</goal></goals><configuration><mainClass>fr.pierrecreeper.trinium.shaders.StandalonePackTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>cache-directory-budget-tests</id><phase>test</phase><goals><goal>java</goal></goals><configuration><mainClass>fr.pierrecreeper.trinium.shaders.CacheDirectoryBudgetTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>self-tests</id><phase>test</phase><goals><goal>java</goal></goals><configuration>
            <mainClass>fr.pierrecreeper.trinium.TriniumSelfTest</mainClass><classpathScope>test</classpathScope>
            <systemProperties><systemProperty><key>trinium.requireNative</key><value>${trinium.requireNative}</value></systemProperty></systemProperties>
          </configuration></execution>
        </executions>
